# Copy to .env only if you want to override the defaults. The stack comes up
# without this file — infra/docker-compose.yml supplies the same values inline.

# ── PostgreSQL / pgvector ────────────────────────────
POSTGRES_USER=search
POSTGRES_PASSWORD=search
POSTGRES_DB=searchdb

# Connection string used by the API gateway and any Python service.
DATABASE_URL=postgresql://search:search@db:5432/searchdb

# ── Host ports ───────────────────────────────────────
# Change these if something already occupies them.
WEB_PORT=5173
API_PORT=8000
ENGINE_PORT=8080
POSTGRES_PORT=5432
